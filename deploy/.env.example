# Copie para deploy/.env e preencha. O .env não vai para o git.

# Endereço do site: um domínio (HTTPS automático) ou :80 (só HTTP;
# também o valor certo quando outro proxy, como o Nginx, faz o HTTPS)
SITE_ADDRESS=:80

# Chave que assina os logins. Gere uma com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Trocar a chave desconecta todos os usuários.
SECRET_KEY=

# Duração do login em minutos (2880 = 2 dias)
ACCESS_TOKEN_EXPIRE_MINUTES=2880

# Cookie só por HTTPS. Use false apenas se o site for acessado por HTTP
# (o cookie só é usado pela documentação da API, desligada em produção)
COOKIE_SECURE=true

# Portas publicadas no servidor. Com o Caddy atendendo direto a internet:
#   HTTP_PORT=80 e HTTPS_PORT=443
# Atrás do Nginx do servidor (README, "Servidor que já usa o Nginx"),
# publique só para a própria máquina; a porta HTTPS fica sem uso, mas não
# pode ser a 443, que é do Nginx:
#   HTTP_PORT=127.0.0.1:8081 e HTTPS_PORT=127.0.0.1:8443
HTTP_PORT=80
HTTPS_PORT=443

# UID do dono da pasta de dados (resultado de "id -u"); o backend roda com
# esse UID para poder gravar as anotações
KPC_UID=1000

# Pasta com os dados (attributions.toml, annotations/, keyphrases/)
# e pasta dos backups; caminhos relativos a esta pasta deploy/
KPC_DATA_DIR=./data
KPC_BACKUP_DIR=./backups

# Backup: intervalo em horas e quantos dias guardar
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30
