OPENAI_API_TOKEN=""
OPENAI_API_TEMPERATURE="0.2"
OPENAI_API_MODEL="gpt-3.5-turbo"
OPENAI_API_MAX_TOKENS="1000"
DATASET_RELATIVE_PATH="dataset"
ATTRIBUTIONS_FILENAME="attributions.toml"
# fill with a secure token with a command like:
# python -c "import secrets; print(secrets.token_urlsafe())"
SECRET_KEY=""
SECURITY_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=2880
COOKIE_DOMAIN="localhost"
COOKIE_PATH="/"
CLUSTER_IDS_LENGTH=33
CURATED_KEYPHRASES_LENGTH=16

# Optional settings (the values below are the defaults).
# Origins allowed to call the API from another address, comma separated;
# leave empty when the frontend and the API share the same address.
# CORS_ORIGINS="http://localhost:5174,http://localhost:4174"
# Login cookie of the legacy interface and of the API docs
# (COOKIE_SECURE="true" requires HTTPS).
# COOKIE_SECURE="false"
# COOKIE_SAMESITE="lax"
# Legacy ReactPy interface at the root of the backend and API docs
# at /api/docs.
# LEGACY_UI_ENABLED="true"
# API_DOCS_ENABLED="true"
